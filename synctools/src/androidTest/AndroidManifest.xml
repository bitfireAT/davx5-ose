<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <!--
    Since Mockk 1.14.7 it's required to use minSdk 26. We use 23, so override for tests.
    -->
    <uses-sdk tools:overrideLibrary="io.mockk.android,io.mockk.proxy.android" />

    <application>
        <service
                android:name="at.bitfire.synctools.test.account.TestAccountAuthenticatorService"
                android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                    android:name="android.accounts.AccountAuthenticator"
                    android:resource="@xml/test_account_authenticator" />
        </service>

        <!-- Test-only registration of the real DavTasksProvider (fixed test authority instead of
        the D1 runtime-discovered one) so storage/davtasks can be tested against a real provider
        instance, same as the DMFS/jtx tests do against their respective real providers. -->
        <provider
                android:name="at.bitfire.davdroid.tasks.provider.DavTasksProvider"
                android:authorities="at.bitfire.synctools.test.davtasks"
                android:exported="false" />
    </application>
</manifest>
